# ---------------------------------------------------------------------------
# AI Medical Video POC — server configuration
# Copy to `server/.env` and fill in what you have. Everything is optional:
# the server degrades to offline engines when a key is missing.
# ---------------------------------------------------------------------------

PORT=3000

# --- AI script writer (optional) -------------------------------------------
# Without this the server uses the deterministic local planner instead.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- AI voice (optional) ---------------------------------------------------
# Preferred: ElevenLabs. It returns character-level timestamps, which gives the
# most accurate lip sync. Without it the server falls back to the macOS
# `say` engine, which works offline with no account.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_turbo_v2_5
ELEVENLABS_VOICE_FEMALE=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_VOICE_MALE=onwK4e9ZLuTAKqWW03F9

# Offline neural voice for Linux (Piper). Binary and models go in
# server/vendor/piper/{piper/piper,voices/*.onnx}. Voice names are model files.
PIPER_VOICE_FEMALE=en_US-lessac-medium
PIPER_VOICE_MALE=en_US-ryan-medium
PIPER_LENGTH_SCALE=1.1

# Force a specific voice engine: elevenlabs | macos | piper | auto
TTS_ENGINE=auto
